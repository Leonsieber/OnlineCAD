{
  "name": "onlinecad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . --pretty",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-react": "^3.50.0",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.17",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "main": "electron/main.cjs",
  "description": "Free parametric 3D CAD in the browser and on the desktop",
  "author": "Leon Sieber",
  "build": {
    "appId": "app.onlinecad.desktop",
    "productName": "OnlineCAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OnlineCAD-Setup.exe",
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "OnlineCAD.dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon-512.png",
      "category": "Graphics",
      "artifactName": "OnlineCAD.AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "Leonsieber",
      "repo": "OnlineCAD"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false
  }
}
