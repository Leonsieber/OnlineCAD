# Copy to .env (never commit .env) to turn on accounts and cloud saves. Both values are in
# Supabase → Project settings → API. The anon key is public by design; row-level security in
# supabase/schema.sql is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
